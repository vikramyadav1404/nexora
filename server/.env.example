# Copy this file to .env and fill in real values:
#   copy .env.example .env

PORT=5000

# true = demo memory | false = Supabase
# Run once: server/db/migrations/001_setup_step_a.sql
DEMO_MODE=false

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_here

JWT_SECRET=change_me_to_a_long_random_string
CLIENT_URL=http://127.0.0.1:5173

# Public API origin for absolute /uploads media URLs (set on Render automatically via RENDER_EXTERNAL_URL)
# PUBLIC_API_URL=https://your-api.onrender.com

# true = upload avatars/posts to Supabase Storage buckets (avatars, posts)
USE_SUPABASE_STORAGE=false

# Payments. Mock mode is decided by these values alone — if they still look
# like placeholders the server auto-approves checkouts. A client can no longer
# ask to skip verification.
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
# Razorpay Dashboard → Settings → Webhooks. Without it a captured payment whose
# browser callback never lands leaves the user paid-but-not-subscribed.
RAZORPAY_WEBHOOK_SECRET=

# AI assists (draft answer, improve question, auto-tag, moderation triage).
# Leave blank to disable them — /api/ai/* then returns 503 and the UI hides them.
ANTHROPIC_API_KEY=

# Live notifications. Supabase → Project Settings → API → JWT Secret.
# Used only to mint short-lived Realtime tokens; never sent to the client.
SUPABASE_JWT_SECRET=

# Encrypts stored TOTP secrets (migration 010). Any long random string.
# A TOTP secret cannot be hashed -- verification needs the original bytes -- so
# it is encrypted instead, with the key held here rather than in Postgres. That
# is what makes a database dump insufficient to generate anyone's codes.
#
# Leave blank and it derives from JWT_SECRET, which works but is worse: rotating
# JWT_SECRET then makes every stored secret undecryptable and silently breaks
# two-factor for everyone at once. Set this before enabling MFA for real users,
# and treat it as un-rotatable unless you also reset every enrolment.
MFA_SECRET_KEY=

# Shared secret for Vercel Cron (digest, checkout sweep). Any long random string.
CRON_SECRET=

EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Optional rate limits
# RATE_LIMIT_API=400
# RATE_LIMIT_AUTH=30
# Signed upload URLs per user per hour (avatar + cover). Default 10.
# RATE_LIMIT_UPLOAD=10

# Optional session tuning. Defaults are the intended values; override only if
# you have a reason. Shortening ACCESS_TOKEN_TTL costs a refresh round-trip more
# often; lengthening it widens the window a stolen access token stays useful,
# and access tokens cannot be revoked — that is what the refresh token is for.
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL_DAYS=30

NODE_ENV=development

# Error monitoring (optional). Create a free project at sentry.io -> copy the DSN.
# Leave blank to disable; errors then log to the console only.
SENTRY_DSN=
