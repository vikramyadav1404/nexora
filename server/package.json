{
  "name": "nexora-server",
  "version": "1.0.0",
  "description": "Nexora Backend - Express + Supabase Postgres",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "verify:supabase": "node db/verifySchema.js",
    "verify:step-a": "node db/verifySchema.js",
    "verify:schema": "node db/verifySchema.js",
    "smoke": "node scripts/smoke.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:email": "node scripts/testEmail.js",
    "backup": "node scripts/backup.js",
    "migration:runner": "node scripts/build-migration-runner.js",
    "keepalive": "node -e \"require('dotenv').config();fetch((process.env.PUBLIC_API_URL||'http://localhost:5000')+'/api/cron/keepalive').then(r=>r.json()).then(j=>console.log(j)).catch(e=>console.error(e.message))\"",
    "stamp": "node scripts/stamp-version.js",
    "deploy": "npm run stamp && vercel deploy --prod --yes",
    "check:buckets": "node scripts/check-buckets.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@supabase/supabase-js": "^2.110.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^6.9.13",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.2",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
