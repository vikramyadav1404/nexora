# Copy to .env if needed
# Local dev: leave empty (Vite proxy handles /api)
VITE_API_URL=

# Live notifications (optional). Supabase → Project Settings → API.
# Use the ANON key here — never the service_role key, which bypasses RLS.
# Leaving these blank disables realtime; the unread badge falls back to
# refreshing on route change.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
